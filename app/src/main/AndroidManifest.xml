<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet untuk koneksi ke n8n -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Kamera untuk modul Bukti Timbang / OCR timbangan -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Mikrofon untuk JARVIS Voice Assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Izin untuk Simpan/Export File Excel -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/logo_app" 
        android:roundIcon="@drawable/logo_app"
        android:label="Cargo Manifest"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.example.cargomanifestapp.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- JARVIS Voice Assistant -->
        <activity
            android:name="com.example.cargomanifestapp.JarvisActivity"
            android:exported="false"
            android:label="JARVIS"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Activity Data Stowingan Palet -->
        <activity
            android:name="com.example.cargomanifestapp.StowingActivity"
            android:exported="false"
            android:label="Data Stowingan Palet"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Activity Baru untuk Bukti Timbang Barang (BTB) -->
        <activity
            android:name="com.example.cargomanifestapp.BuktiTimbangActivity"
            android:exported="false"
            android:label="Bukti Timbang Barang"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Activity OCR timbangan yang dibuka dari Bukti Timbang Barang -->
        <activity
            android:name="com.example.cargomanifestapp.ScaleOcrActivity"
            android:exported="false"
            android:label="OCR Timbangan"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Activity penerbitan / cetak label BTB -->
        <activity
            android:name="com.example.cargomanifestapp.BtbLabelActivity"
            android:exported="false"
            android:label="Terbitkan Label BTB"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Flight Tracking terpisah dari seluruh workflow Cargo Manifest -->
        <activity
            android:name="com.example.cargomanifestapp.FlightTrackingActivity"
            android:exported="false"
            android:label="Flight Tracking"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Provider untuk Berbagi File Excel -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.cargomanifestapp.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
